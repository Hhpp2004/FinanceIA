<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="finance_model" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="63694f7c-89c4-4f3d-b2b3-6e3b56b30b3c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="USER_ID" class="java.lang.Integer"/>
	<parameter name="EXTRATO_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    o.id             AS operacao_id,
    o.categoria      AS operacao_categoria,
    o.data           AS operacao_data,
    o.descricao      AS operacao_descricao,
    o.nome           AS operacao_nome,
    o.time           AS operacao_time,
    o.valor          AS operacao_valor,
    o.tipo           AS operacao_tipo,

    e.date           AS extrato_data,
    e.nome           AS extrato_nome,
    e.saldo_id       AS extrato_saldo_id,

    se.saldo_atual   AS extrato_saldo_atual,
    se.saldo_entrada AS extrato_saldo_entrada,
    se.saldo_saida   AS extrato_saldo_saida,

    u.nome           AS usuario_nome,
    u.telefone       AS usuario_telefone,
    u.email          AS usuario_email,
    u.saldo_id       AS usuario_saldo_id,

    su.saldo_atual   AS usuario_saldo_atual,
    COALESCE((
        SELECT SUM(ABS(operacao_mes.valor))
        FROM operacao operacao_mes
        INNER JOIN extrato extrato_mes
            ON operacao_mes.extrato_id = extrato_mes.id
        WHERE extrato_mes.user_id = u.id
          AND operacao_mes.tipo = 'ENTRADA'
          AND operacao_mes.data BETWEEN date_trunc('month', CURRENT_DATE)::date
              AND (date_trunc('month', CURRENT_DATE) + INTERVAL '1 month - 1 day')::date
    ), 0) AS usuario_saldo_entrada,
    COALESCE((
        SELECT SUM(ABS(operacao_mes.valor))
        FROM operacao operacao_mes
        INNER JOIN extrato extrato_mes
            ON operacao_mes.extrato_id = extrato_mes.id
        WHERE extrato_mes.user_id = u.id
          AND operacao_mes.tipo = 'SAIDA'
          AND operacao_mes.data BETWEEN date_trunc('month', CURRENT_DATE)::date
              AND (date_trunc('month', CURRENT_DATE) + INTERVAL '1 month - 1 day')::date
    ), 0) AS usuario_saldo_saida

FROM operacao o

INNER JOIN extrato e
    ON o.extrato_id = e.id

INNER JOIN users u
    ON e.user_id = u.id

INNER JOIN saldo se
    ON e.saldo_id = se.saldo

INNER JOIN saldo su
    ON u.saldo_id = su.saldo

WHERE u.id = $P{USER_ID}
  AND e.id = CAST($P{EXTRATO_ID} AS uuid)

ORDER BY o.id ASC]]>
	</queryString>
